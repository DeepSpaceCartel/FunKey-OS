From: Aleksandr Ilin <ceo@deepspacecartel.com>
Subject: [PATCH] ARM: use the section flag and type syntax current binutils accepts

Binutils 2.44 rejects the old "#alloc, #execinstr" section flag syntax and
the "#function"/"#object" symbol types in ARM assembly ("junk at end of
line, first unrecognized character is `#'"). Use the quoted flag string
and the "%" type prefix, which every binutils version accepts. The
meaning is unchanged.

The change is mechanical: ".section X, #alloc" becomes ".section X, "a"",
"#alloc, #execinstr" becomes "ax", and ".type X, #function" or "#object"
becomes "%function" or "%object". It touches 37 files under arch/arm.

---
diff --git a/arch/arm/boot/bootp/init.S b/arch/arm/boot/bootp/init.S
--- a/arch/arm/boot/bootp/init.S
+++ b/arch/arm/boot/bootp/init.S
@@ -16,8 +16,8 @@
  *  size immediately following the kernel, we could build this into
  *  a binary blob, and concatenate the zImage using the cat command.
  */
-		.section .start,#alloc,#execinstr
-		.type	_start, #function
+		.section .start, "ax"
+		.type	_start, %function
 		.globl	_start
 
 _start:		add	lr, pc, #-0x8		@ lr = current load addr
@@ -75,7 +75,7 @@
 
 		.align
 
-		.type	data,#object
+		.type	data,%object
 data:		.word	initrd_start		@ source initrd address
 		.word	initrd_phys		@ destination initrd address
 		.word	initrd_size		@ initrd size
diff --git a/arch/arm/boot/bootp/initrd.S b/arch/arm/boot/bootp/initrd.S
--- a/arch/arm/boot/bootp/initrd.S
+++ b/arch/arm/boot/bootp/initrd.S
@@ -1,5 +1,5 @@
 /* SPDX-License-Identifier: GPL-2.0 */
-	.type	initrd_start,#object
+	.type	initrd_start,%object
 	.globl	initrd_start
 initrd_start:
 	.incbin	INITRD
diff --git a/arch/arm/boot/compressed/big-endian.S b/arch/arm/boot/compressed/big-endian.S
